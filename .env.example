# --- Database (Neon: copy the pooled connection string) ---
DATABASE_URL=postgres://user:pass@host/dbname?sslmode=require

# --- Public URL of the deployed app (no trailing slash). Used for the Google redirect. ---
APP_URL=https://your-app.vercel.app

# --- Google sign-in ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Only these Google accounts can sign in. Roles: admin (parent) | child (student)
AUTH_ALLOWLIST=mr.edisasongko@gmail.com:admin,alfathyusufi@gmail.com:child
# Random string, 32+ chars (e.g. `openssl rand -base64 32`). Signs session cookies.
AUTH_SECRET=

# --- Chat agent (Claude API) ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5

# --- Web push reminders (generate with: npm run vapid) ---
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:mr.edisasongko@gmail.com
NEXT_PUBLIC_VAPID_PUBLIC_KEY=

# --- Vercel cron auth (Vercel sends: Authorization: Bearer $CRON_SECRET) ---
CRON_SECRET=
